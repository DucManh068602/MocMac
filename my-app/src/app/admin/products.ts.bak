import { Component, inject, signal, computed } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { ToastService } from './toast.service';
import { ProductsService } from '../products.service';

@Component({
  selector: 'app-admin-products',
  standalone: false,
  template: `
    <div class="list-page">
      <header class="list-header">
        <h2>Sáº£n pháº©m ({{ total() || products().length }})</h2>
        <div class="admin-filters">
          <div class="filter-group">
            <input
              class="filter-input"
              placeholder="TÃ¬m tÃªn sáº£n pháº©m..."
              [(ngModel)]="searchTerm"
              (input)="onFilterChange()"
              style="width: 200px"
            />
          </div>
          <div class="filter-group">
            <select class="filter-select" [(ngModel)]="categoryFilter" (change)="onFilterChange()" style="width: 160px">
              <option value="">Táº¥t cáº£ danh má»¥c</option>
              <option value="Äáº·c sáº£n">Äáº·c sáº£n</option>
              <option value="Thá»§ cÃ´ng má»¹ nghá»‡">Thá»§ cÃ´ng má»¹ nghá»‡</option>
              <option value="CÃ  phÃª - TrÃ ">CÃ  phÃª - TrÃ </option>
              <option value="Sáº£n pháº©m OCOP">Sáº£n pháº©m OCOP</option>
            </select>
          </div>
          <div class="filter-group">
            <select class="filter-select" [(ngModel)]="stockFilter" (change)="onStockFilterChange()" style="width: 160px">
              <option value="">Táº¥t cáº£ tá»“n kho</option>
              <option value="in">CÃ²n hÃ ng</option>
              <option value="out">Háº¿t hÃ ng</option>
            </select>
          </div>
          <button
            type="button"
            class="filter-reset"
            (click)="resetFilters()"
            [disabled]="!searchTerm && !categoryFilter && !stockFilter"
          >
            XÃ³a bá»™ lá»c
          </button>
        </div>
        <button type="button" class="btn-add" (click)="startCreate(); showForm.set(true)">ThÃªm</button>
      </header>

      <div class="stats-grid">
        <div class="stat-card stat--moss">
          <span class="stat-value">{{ total() || products().length }}</span>
          <span class="stat-label">Tá»•ng SP</span>
        </div>
        <div class="stat-card stat--earth">
          <span class="stat-value">{{ stats().inStock }}</span>
          <span class="stat-label">CÃ²n hÃ ng (Ä‘Ã£ táº£i)</span>
        </div>
        <div class="stat-card stat--clay">
          <span class="stat-value">{{ stats().outOfStock }}</span>
          <span class="stat-label">Háº¿t hÃ ng (Ä‘Ã£ táº£i)</span>
        </div>
        <div class="stat-card stat--sage">
          <span class="stat-value">{{ stats().avgRating | number:'1.1-1' }}</span>
          <span class="stat-label">Äiá»ƒm TB (Ä‘Ã£ táº£i)</span>
        </div>
      </div>

      @if (showForm()) {
        <div class="form-card">
          <h3>{{ editing() ? 'Sá»­a' : 'ThÃªm' }} sáº£n pháº©m</h3>
          <div class="form-grid">
            <input class="form-input" placeholder="TÃªn sáº£n pháº©m" [(ngModel)]="form.name" (input)="genSlug()" />
            <input class="form-input" placeholder="Slug" [(ngModel)]="form.slug" />
            <input class="form-input" placeholder="GiÃ¡" type="number" [(ngModel)]="form.price" />
            <input class="form-input" placeholder="Tá»“n kho (máº·c Ä‘á»‹nh 100)" type="number" [(ngModel)]="form.stock" />
            <select class="form-input form-select-sm" [(ngModel)]="form.deal">
              <option [ngValue]="null">KhÃ´ng Ã¡p dá»¥ng Deal</option>
              @for (deal of deals(); track deal._id) { <option [ngValue]="deal._id">{{ deal.title }} Â· {{ deal.discountType === 'percent' ? '-' + deal.discountValue + '%' : '-' + deal.discountValue + 'Ä‘' }}</option> }
            </select>
            <select class="form-input form-select-sm" [(ngModel)]="form.cat">
              <option value="">Danh má»¥c</option>
              <option value="Äáº·c sáº£n">Äáº·c sáº£n</option>
              <option value="Thá»§ cÃ´ng má»¹ nghá»‡">Thá»§ cÃ´ng má»¹ nghá»‡</option>
              <option value="CÃ  phÃª - TrÃ ">CÃ  phÃª - TrÃ </option>
              <option value="Sáº£n pháº©m OCOP">Sáº£n pháº©m OCOP</option>
            </select>
            <select class="form-input form-select-sm" [(ngModel)]="form.region" placeholder="VÃ¹ng miá»n">
              <option value="">Chá»n vÃ¹ng miá»n</option>
              @for (r of regions(); track r.slug) {
                <option [ngValue]="r.name">{{ r.name }}</option>
              }
            </select>
            <select class="form-input form-select-sm" [(ngModel)]="form.province" placeholder="Tá»‰nh">
              <option value="">Chá»n tá»‰nh</option>
              @for (p of provinces(); track p.code) {
                <option [ngValue]="p.name">{{ p.name }}</option>
              }
            </select>
            <select class="form-input form-select-sm" [(ngModel)]="form.village" placeholder="LÃ ng nghá»">
              <option value="">Chá»n lÃ ng nghá»</option>
              @for (v of villages(); track v) {
                <option [ngValue]="v">{{ v }}</option>
              }
            </select>
            <div class="upload-area-sm" (click)="fileInput.click()" (dragover)="onDragOver($event)" (drop)="onDrop($event)">
              <input type="file" #fileInput multiple accept="image/*" (change)="onFileSelect($event)" style="display:none" />
              <div class="upload-placeholder-sm">
                <span>ðŸ“ áº¢nh</span>
                <small>JPG, PNG (5MB)</small>
              </div>
              @if (previewImages().length > 0) {
                <div class="preview-grid-sm">
                  @for (img of previewImages(); track img; let i = $index) {
                    <div class="preview-item-sm">
                      <img [src]="img" alt="Preview" />
                      <button type="button" class="remove-btn-sm" (click)="removePreview(i)" title="XÃ³a">Ã—</button>
                    </div>
                  }
                </div>
              }
            </div>
            <textarea class="form-input" placeholder="MÃ´ táº£" [(ngModel)]="form.description"></textarea>
          </div>
          <div class="form-actions">
            <button type="button" class="btn-save" (click)="saveProduct()">LÆ°u</button>
            <button type="button" class="btn-cancel" (click)="showForm.set(false)">Há»§y</button>
          </div>
        </div>
      }

      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>STT</th>
              <th>TÃªn</th>
              <th>áº¢nh</th>
              <th>GiÃ¡</th>
              <th>Tá»“n kho</th>
              <th>Danh má»¥c</th>
              <th>Thao tÃ¡c</th>
            </tr>
          </thead>
          <tbody>
            @for (p of products(); track p.slug || p.id; let i = $index) {
              <tr>
                <td>{{ i + 1 }}</td>
                <td>{{ p.name }}</td>
                <td>
                  @if (p.images?.length) {
                    <img [src]="p.images[0]" class="thumb-img" />
                  }
                </td>
                <td>{{ p.price }}Ä‘</td>
                <td>{{ p.stock ?? p.totalStock ?? 0 }}</td>
                <td>{{ p.cat }}</td>
                <td>
                  <button type="button" class="btn-small" (click)="editProduct(p)">Sá»­a</button>
                  <button type="button" class="btn-small btn-delete" (click)="deleteProduct(p.slug)">XÃ³a</button>
                </td>
              </tr>
            } @empty {
              <tr><td colspan="7">{{ loading() ? 'Äang táº£i...' : 'ChÆ°a cÃ³ sáº£n pháº©m nÃ o.' }}</td></tr>
            }
          </tbody>
        </table>
      </div>
      @if (hasMore()) {
        <div class="load-more-wrap">
          <button type="button" class="btn-load-more" (click)="loadMore()" [disabled]="loading()">
            {{ loading() ? 'Äang táº£i...' : 'Táº£i thÃªm sáº£n pháº©m' }} ({{ products().length }}/{{ total() }})
          </button>
        </div>
      } @else if (products().length > 0) {
        <div class="load-more-wrap load-more-done">ÄÃ£ hiá»ƒn thá»‹ {{ products().length }}/{{ total() }} sáº£n pháº©m.</div>
      }
    </div>
  `,
  styleUrls: ['./admin-list.css'],
  styles: [`
    .load-more-wrap { display: flex; justify-content: center; padding: 16px 0 4px; }
    .btn-load-more { padding: 10px 18px; border: 1px solid #d6ceb9; border-radius: 10px; background: #fff; color: var(--ink, #16231f); font: 600 13px inherit; cursor: pointer; transition: all .2s; }
    .btn-load-more:hover:not(:disabled) { background: #f4f3ec; border-color: var(--moss, #2e5a3c); }
    .btn-load-more:disabled { opacity: .65; cursor: wait; }
    .load-more-done { font-size: 13px; color: #666; }
  `],
})
export class AdminProductsComponent {
  private http = inject(HttpClient);
  private toast = inject(ToastService);
  private ps = inject(ProductsService);
  readonly products = signal<any[]>([]);
  readonly provinces = signal<any[]>([]);
  readonly villages = signal<string[]>([]);
  readonly regions = computed(() => this.ps.regions());
  readonly deals = signal<any[]>([]);
  readonly page = signal(1);
  readonly totalPages = signal(1);
  readonly showForm = signal(false);
  readonly editing = signal<any>(null);
  readonly previewImages = signal<string[]>([]);
  form: any = {};
  searchTerm = '';
  categoryFilter = '';
  stockFilter = '';

  readonly stats = computed(() => {
    const p = this.products();
    const withRating = p.filter((x: any) => x.rate > 0);
    const avgRating = withRating.length > 0
      ? withRating.reduce((s: number, x: any) => s + x.rate, 0) / withRating.length
      : 0;
    return {
      total: p.length,
      inStock: p.filter((x: any) => x.inStock).length,
      outOfStock: p.filter((x: any) => !x.inStock).length,
      avgRating: Number(avgRating.toFixed(1)),
    };
  });

  constructor() {
    this.loadProducts();
    this.loadProvinces();
    this.loadVillages();
    this.loadDeals();
  }

  onFilterChange(): void {
    this.page.set(1);
    this.loadProducts();
  }

  resetFilters(): void {
    this.searchTerm = '';
    this.categoryFilter = '';
    this.stockFilter = '';
    this.page.set(1);
    this.loadProducts();
  }

  onStockFilterChange(): void {
    this.page.set(1);
    this.loadProducts();
  }

  loadProducts(): void {
    const params = new URLSearchParams({
      page: String(this.page()),
      limit: '12',
    });
    if (this.searchTerm) params.set('q', this.searchTerm);
    if (this.categoryFilter) params.set('cat', this.categoryFilter);
    if (this.stockFilter) params.set('stock', this.stockFilter);

    this.http.get('/api/products?' + params.toString()).subscribe((r: any) => {
      const items = Array.isArray(r) ? r : (r.products || []);
      this.products.set(items);
      this.totalPages.set(r.totalPages || 1);
    });
  }

  genSlug(): void {
    if (this.editing()) return;
    const name: string = this.form.name || '';
    this.form.slug = name
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[Ä‘]/g, 'd')
      .replace(/[^a-z0-9\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-+|-+$/g, '');
  }

  loadProvinces(): void {
    this.http.get('/api/provinces').subscribe((r: any) => {
      this.provinces.set(Array.isArray(r) ? r : []);
    });
  }

  loadVillages(): void {
    this.http.get('/api/villages').subscribe((r: any) => {
      this.villages.set(Array.isArray(r) ? r : []);
    });
  }

  loadDeals(): void { this.http.get<any>('/api/deals?active=true&limit=100').subscribe(r => this.deals.set(r.deals || [])); }

  startCreate(): void {
    this.editing.set(null);
    this.form = { name: '', slug: '', price: 0, stock: 100, deal: null, cat: '', region: '', province: '', village: '', images: [], description: '' };
    this.previewImages.set([]);
  }

  editProduct(p: any): void {
    this.editing.set(p);
    this.form = { ...p, deal: p.deal?._id || p.deal || null, images: p.images || [] };
    this.previewImages.set(p.images || []);
    this.showForm.set(true);
  }

  onFileSelect(event: Event): void {
    const input = event.target as HTMLInputElement;
    if (input.files) {
      this.uploadFiles(Array.from(input.files));
    }
    input.value = '';
  }

  onDragOver(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();
    (event.target as HTMLElement).classList.add('drag-over');
  }

  onDrop(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();
    (event.target as HTMLElement).classList.remove('drag-over');
    if (event.dataTransfer?.files) {
      this.uploadFiles(Array.from(event.dataTransfer.files));
    }
  }

  uploadFiles(files: File[]): void {
    const validFiles = files.filter(f => f.type.startsWith('image/') && f.size <= 5 * 1024 * 1024);
    if (validFiles.length === 0) {
      this.toast.error('File khÃ´ng há»£p lá»‡. Chá»‰ cháº¥p nháº­n áº£nh (JPG, PNG, WebP, GIF) dÆ°á»›i 5MB.');
      return;
    }

    const formData = new FormData();
    validFiles.forEach(f => formData.append('images', f));

    this.http.post('/api/uploads/image', formData).subscribe({
      next: (res: any) => {
        if (res.success && res.urls) {
          const newImages = [...this.previewImages(), ...res.urls];
          this.previewImages.set(newImages);
          this.form.images = newImages;
          this.toast.success(`ÄÃ£ táº£i lÃªn ${res.urls.length} áº£nh`);
        }
      },
      error: (err) => {
        this.toast.error(err.error?.message || 'Táº£i lÃªn áº£nh tháº¥t báº¡i');
      },
    });
  }

  removePreview(index: number): void {
    const images = [...this.previewImages()];
    images.splice(index, 1);
    this.previewImages.set(images);
    this.form.images = images;
  }

  saveProduct(): void {
    const f = { ...this.form };
    f.images = this.previewImages();

    if (this.editing()) {
      this.http.put('/api/products/' + f.slug, f).subscribe({
        next: () => { this.toast.success('Cáº­p nháº­t sáº£n pháº©m thÃ nh cÃ´ng'); this.loadProducts(); this.showForm.set(false); },
        error: () => this.toast.error('KhÃ´ng thá»ƒ cáº­p nháº­t sáº£n pháº©m'),
      });
    } else {
      this.http.post('/api/products', f).subscribe({
        next: () => { this.toast.success('ThÃªm sáº£n pháº©m thÃ nh cÃ´ng'); this.loadProducts(); this.showForm.set(false); },
        error: () => this.toast.error('KhÃ´ng thá»ƒ thÃªm sáº£n pháº©m'),
      });
    }
  }

  deleteProduct(slug: string): void {
    if (confirm('XÃ³a sáº£n pháº©m nÃ y?')) {
      this.http.delete('/api/products/' + slug).subscribe({
        next: () => { this.toast.success('XÃ³a sáº£n pháº©m thÃ nh cÃ´ng'); this.loadProducts(); },
        error: () => this.toast.error('KhÃ´ng thá»ƒ xÃ³a sáº£n pháº©m'),
      });
    }
  }
}

